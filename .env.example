# Cloudflare Worker環境設定
ENVIRONMENT=development
LOG_LEVEL=debug

# MCP Server設定
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_NAME=cloudflare-vectorize-mcp-server

# Vectorize設定
VECTORIZE_INDEX_NAME=rag-index
DEFAULT_TOP_K=10
DEFAULT_THRESHOLD=0.7

# エンベディングAPI設定（OpenAI or Cloudflare AI）
EMBEDDING_API_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
CLOUDFLARE_AI_API_TOKEN=your-cloudflare-ai-token-here

# 認証設定
AUTH_ENABLED=true
DEFAULT_AUTH_TOKEN=your-default-auth-token-here

# レート制限設定
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# キャッシュ設定
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# デバッグ設定
DEBUG_MODE=true
VERBOSE_LOGGING=true